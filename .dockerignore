# Build artifacts (regenerated by `cargo build` inside the image; the host
# target/ dir is huge and would otherwise dominate the build context).
/target

# VCS / editor / OS cruft
.git/
.github/
.claude/
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Docs — not needed to compile the workspace.
docs/
*.md
DESIGN-*.md

# Secrets / local env — never send these into the build context.
.env
.env.local
*.pem
*.key

# Install scripts / release tooling — unrelated to the container build.
install.sh
uninstall.sh

# Compose-local artifacts
docker-compose.override.yml
