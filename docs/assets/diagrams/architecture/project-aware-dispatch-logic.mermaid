flowchart TD
    Start([fleet_dispatch_task<br/>server_hint, required_labels, model, project_id?]) --> FilterOnline[1. WorkerStatus::Online 워커만 후보로]
    FilterOnline --> FilterLabels[2. required_labels를 만족하지 않는 워커 제외]
    FilterLabels --> CheckModel{model이 지정되었는가?}
    CheckModel -- Yes --> FilterModel[2.5. labels 'model'이 일치하지 않는 워커 제외]
    CheckModel -- No --> FilterBreaker
    FilterModel --> FilterBreaker[3. 회로차단기 Open인 워커 제외]
    FilterBreaker --> FilterCapacity[3.5. has_capacity 실패 워커 제외]
    FilterCapacity --> CheckProject{"신규 5.5(문서 편의상 표기,<br/>실제 삽입 위치는 3.5와 4 사이). project_id가 지정되었는가?"}
    CheckProject -- No --> CheckHint{server_hint가 지정되었는가?}
    CheckProject -- Yes --> FilterProject["worker.project_id == project_id가<br/>아닌 워커 제외 (하드 retain, required_labels/model과 동일한 취급)"]
    FilterProject --> AnyLeft{후보가 남아있는가?}
    AnyLeft -- Yes --> CheckHint
    AnyLeft -- "No — 하드 실패" --> RejectProject(["SelectionError::NoWorkerForProject<br/>— 전체 풀로 폴백하지 않음"])
    RejectProject --> RetryPath["dispatch_existing()이 WorkerUnavailable과 동일하게 취급<br/>→ #38 재시도 경로 재사용:<br/>재시도 비활성이면 즉시 Failed,<br/>활성이면 Pending 유지 + retry_count 증가 → Reconciler가 재시도<br/>(그 사이 #49 Automatic 모드가 새 agent를 띄웠을 수도 있음)<br/>→ 소진되면 dead-letter(Failed)"]

    CheckHint -- Yes --> HintLookup["4. server_hint 처리 —<br/>힌트 워커를 이름으로 조회<br/>(5.5단계 이후 평가 — 힌트 워커가 다른 프로젝트 소속이면<br/>이미 후보 풀에서 빠져 있어 자연히 거부됨)"]
    HintLookup --> HintExists{조회 결과}
    HintExists -- 워커 자체가 없음 --> RejectNotFound([HintedNotFound 에러])
    HintExists -- "존재하지만 3/3.5/5.5단계에서 제외됨" --> RejectUnavailable([HintedUnavailable 에러])
    HintExists -- 후보 풀에 존재 --> Dispatch
    CheckHint -- No --> FilterLeastLoaded["5. active_tasks 최소인 워커 선택<br/>(동률이면 name 순)"]
    FilterLeastLoaded --> Dispatch([선택된 워커로 Dispatch])
